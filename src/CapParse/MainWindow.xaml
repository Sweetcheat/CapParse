<Window x:Class="CapParse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CapParse"
        mc:Ignorable="d"
        Title="CapParse" Height="560" Width="960">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="CapParse"
                   FontSize="24"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

        <TextBlock Grid.Row="1"
                   Text="Capture uma região (Ctrl + Shift + X) para reconhecer o texto."
                   Margin="0,8,0,16"
                   Foreground="Gray"
                   HorizontalAlignment="Center" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Result of the current run: status, text, and the explicit
                 copy action. Driven by the app's OcrRunState. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Row="0"
                           FontSize="14"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Border x:Name="ResultPanel"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        BorderBrush="#808080"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBox x:Name="ResultText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Padding="8" />
                </Border>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button x:Name="CopyButton"
                            Content="Copiar texto"
                            MinWidth="120"
                            Padding="12,6"
                            IsEnabled="False"
                            Click="CopyText_Click" />
                    <TextBlock x:Name="CopyFeedback"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray" />
                    <Button x:Name="CopyImageButton"
                            Content="Copiar imagem"
                            MinWidth="120"
                            Padding="12,6"
                            Margin="16,0,0,0"
                            IsEnabled="False"
                            Click="CopyImage_Click" />
                    <TextBlock x:Name="ImageCopyFeedback"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray" />
                </StackPanel>
            </Grid>

            <!-- History of the session's recognized results, most recent
                 first. Selecting an entry shows its full text and lets the
                 user copy it again; it never touches the current result or
                 the run state. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Histórico da sessão"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <ListBox x:Name="HistoryList"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding DisplayTime}"
                                           FontSize="11"
                                           Foreground="Gray" />
                                <TextBlock Text="{Binding Preview}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        BorderBrush="#808080"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="HistoryEmpty"
                                   Text="Nenhum resultado anterior nesta sessão."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8" />
                        <TextBox x:Name="HistoryText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Padding="8"
                                 Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button x:Name="HistoryCopyButton"
                            Content="Copiar do histórico"
                            MinWidth="140"
                            Padding="12,6"
                            IsEnabled="False"
                            Click="HistoryCopy_Click" />
                    <TextBlock x:Name="HistoryCopyFeedback"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

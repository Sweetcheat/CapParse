<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Version metadata (M15): the candidate version for the next beta
         package. Version feeds InformationalVersion ("0.1.0-beta.2");
         AssemblyVersion/FileVersion stay numeric (4-part) as Windows
         requires. build/publish-win-x64.ps1 reads <Version> as the single
         source of truth for the package name. -->
    <Version>0.1.0-beta.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationManifest>$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
    <!-- Win32Manifest must be set explicitly: WPF's inner build (temp project) runs CoreCompile
         directly, bypassing the SDK target that maps ApplicationManifest -> Win32Manifest, so the
         final assembly (and the apphost that copies resources from it) would lose the manifest. -->
    <Win32Manifest>$(MSBuildThisFileDirectory)app.manifest</Win32Manifest>
    <!-- WFAC010 (WinForms analyzer): DPI awareness is declared in app.manifest because this is a WPF process.
         WinForms is used only for the tray icon and never calls Application.SetHighDpiMode. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Official mascot icon (approved): the exe icon comes from here; the same file
         is also a WPF Resource, so the main window and the tray load one shared source. -->
    <ApplicationIcon>Assets\capparse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\capparse.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

  <Import Project="..\..\build\OcrModels.targets" />

</Project>

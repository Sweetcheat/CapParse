<Window x:Class="CapParse.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao CapParse"
        Width="520" Height="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Bem-vindo ao CapParse"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="O CapParse captura uma região da sua tela e reconhece o texto dela, localmente."
                       TextWrapping="Wrap" />
            <TextBlock x:Name="HowToCaptureText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0"
                       Text="Depois de selecionar a região, você pode copiar o texto, copiar a imagem ou salvá-la em um arquivo."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Button Grid.Row="2"
                x:Name="StartButton"
                Content="Começar"
                MinWidth="130"
                Padding="16,7"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                IsDefault="True"
                Click="StartButton_Click" />
    </Grid>
</Window>

<Window x:Class="CapParse.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao CapParse"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <!--
        Window-scoped styles (V0.2, phase 4): the same approach as
        MainWindow (phase 2) and SettingsWindow (phase 3) — a Modern
        Fluent look built only on the shared semantic tokens (Dynamic
        Resource), so every element re-skins when the theme dictionary is
        swapped. Scoped to this window on purpose: the other windows keep
        their own copies of these styles.
    -->
    <Window.Resources>

        <!-- Shared button template: rounded chrome, a hover/pressed
             overlay (low-alpha, so it works on both the neutral surface
             and the accent fill) and an outer focus ring. The dotted
             WPF focus visual is replaced by the ring. -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="FocusRing"
                        CornerRadius="10"
                        Margin="2"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource FocusBorderBrush}"
                        Opacity="0" />
                <Border x:Name="Chrome"
                        CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Border x:Name="Overlay"
                                CornerRadius="6"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtleOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Neutral (secondary) button. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        </Style>

        <!-- Accent (primary) button: same shape and states, accent fill. -->
        <Style x:Key="AccentButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <!--
        The content is sized to fit (SizeToContent="Height" on the window),
        so the welcome text and the button are never clipped, no matter how
        the dynamic "how to capture" line wraps. The ScrollViewer is a
        protection for the extreme case in which the content is taller than
        the available desktop area (large fonts on a low screen): its
        MaxHeight is set from the work area in code, and the window then
        keeps a scrollbar instead of growing beyond the screen.
    -->
    <ScrollViewer x:Name="ContentScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Bem-vindo ao CapParse"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Left" />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Margin="16">
                <TextBlock Text="O CapParse captura uma região da sua tela e reconhece o texto dela, localmente."
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="HowToCaptureText"
                           Margin="0,12,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Depois de selecionar a região, você pode copiar o texto, copiar a imagem ou salvá-la em um arquivo." />
            </StackPanel>
        </Border>

        <!-- The mode choice (V0.3, stage 5): the traditional flow, the
             direct mode, or deferring the decision. The presentation never
             creates a hotkey on its own: choosing the direct mode only
             flips the mode's flag, and the shortcuts are configured in the
             settings. "Agora não" — like closing the window — keeps the
             traditional mode, so a dismissed presentation never changes a
             setting and never blocks the normal use of the application. -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Margin="16">
                <TextBlock Text="Como você quer usar o CapParse?"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <Border Margin="0,10,0,0"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Margin="12,8">
                        <TextBlock Text="Modo Tradicional"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TraditionalModeDescriptionText"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Selecione uma região, veja o resultado e escolha copiar ou salvar. Recomendado para quem está começando." />
                    </StackPanel>
                </Border>

                <Border Margin="0,8,0,0"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Margin="12,8">
                        <TextBlock Text="Modo Direto"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="DirectModeDescriptionText"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Selecione uma região e a ação configurada é executada na hora, sem a janela de resultado. Os atalhos (copiar imagem, OCR + copiar texto, salvar imagem) são definidos por você em Configurações." />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="TraditionalButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Modo Tradicional"
                            MinWidth="130"
                            IsDefault="True"
                            Click="TraditionalButton_Click" />
                    <Button x:Name="DirectButton"
                            Content="Modo Direto"
                            MinWidth="0"
                            Padding="14,7"
                            Margin="8,0,0,0"
                            Click="DirectButton_Click" />
                    <Button x:Name="DeferButton"
                            Content="Agora não"
                            MinWidth="0"
                            Padding="14,7"
                            Margin="8,0,0,0"
                            Click="DeferButton_Click" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Text="Agora não continua com o Modo Tradicional. Você pode mudar essa escolha em Configurações." />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        CapParse light theme tokens (V0.2, phase 1).

        The keys are semantic, not concrete colors: views reference the
        meaning (BackgroundBrush, TextSecondaryBrush, ...), never a hex
        value, so no window carries its own palette. Theme.Dark.xaml
        defines exactly the same keys with the dark values.

        Text tokens meet WCAG AA (4.5:1) against SurfaceBrush and
        BackgroundBrush; OnAccentBrush meets it against AccentBrush.

        The subtle-state tokens are low-alpha overlays, so they compose
        over whatever surface they sit on (buttons, list items) without
        needing a variant per surface.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#E9EBEF" />

    <!-- Lines and outlines -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D6DAE0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#A9B0BA" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1E24" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#464E58" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F6771" />

    <!-- Accent (primary action) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6BE6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C82F0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2456C2" />

    <!-- Subtle interaction states (hover/pressed overlays, selection tint) -->
    <SolidColorBrush x:Key="SubtleOverlayBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#33000000" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F2E6BE6" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7F3C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0362C" />

    <!-- Focus indication -->
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#2E6BE6" />

    <!-- Capture overlay (freeze-frame) -->
    <!-- Dim over the frozen desktop. The dark theme uses a lighter dim so
         already-dark screen content stays recognizable. -->
    <SolidColorBrush x:Key="OverlayDimBrush" Color="#80000000" />
</ResourceDictionary>

<Window x:Class="CapParse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <!--
        Window-scoped styles (V0.2, phase 3): the same approach as
        MainWindow (phase 2) — a Modern Fluent look built only on the
        shared semantic tokens (Dynamic Resource), so every element
        re-skins when the theme dictionary is swapped. Scoped to this
        window on purpose: FirstRunWindow keeps its current look.
    -->
    <Window.Resources>

        <!-- Shared button template: rounded chrome, a hover/pressed
             overlay (low-alpha, so it works on both the neutral surface
             and the accent fill) and an outer focus ring. The dotted
             WPF focus visual is replaced by the ring. -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="FocusRing"
                        CornerRadius="10"
                        Margin="2"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource FocusBorderBrush}"
                        Opacity="0" />
                <Border x:Name="Chrome"
                        CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Border x:Name="Overlay"
                                CornerRadius="6"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtleOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- The same shape as the button template, for the direct mode's
             toggle: a ControlTemplate's TargetType must match the type of
             the control it is applied to, and a ToggleButton is not a
             Button (the other way around is), so the toggle needs its own
             copy of the template. Pointing the toggle at the Button-typed
             template makes WPF throw when the window is shown (the first
             layout pass is when the template is instantiated). -->
        <ControlTemplate x:Key="ToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="FocusRing"
                        CornerRadius="10"
                        Margin="2"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource FocusBorderBrush}"
                        Opacity="0" />
                <Border x:Name="Chrome"
                        CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Border x:Name="Overlay"
                                CornerRadius="6"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtleOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Neutral (secondary) button. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        </Style>

        <!-- Accent (primary) button: same shape and states, accent fill. -->
        <Style x:Key="AccentButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- The "direct mode" toggle: the button shape, with the accent
             fill while checked (the same states as the buttons). The
             template is the ToggleButton-typed one (a Button-typed
             template cannot be applied to a ToggleButton). -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ToggleButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slim, borderless list: items are the visual unit. -->
        <ControlTemplate x:Key="ListBoxTemplate" TargetType="ListBox">
            <ScrollViewer x:Name="PART_ItemsHost"
                          Focusable="False"
                          Padding="4"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template" Value="{StaticResource ListBoxTemplate}" />
        </Style>

        <!-- List item: hover overlay, accent-tinted selection, focus
             ring; disabled dims the item. -->
        <ControlTemplate x:Key="ListBoxItemTemplate" TargetType="ListBoxItem">
            <Grid>
                <Border x:Name="FocusRing"
                        CornerRadius="7"
                        Margin="1"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource FocusBorderBrush}"
                        Opacity="0" />
                <Border x:Name="ItemBackground"
                        CornerRadius="6"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background"
                            Value="{DynamicResource SubtleOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background"
                            Value="{DynamicResource AccentSubtleBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}" />
        </Style>

        <!-- The folder display of the automatic save policy. -->
        <Style x:Key="FolderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <!-- Section header inside a pane. -->
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <!--
        The content is sized to fit (SizeToContent="Height" on the window),
        so no pane is ever clipped, no matter how the notes wrap. The
        ScrollViewer is a protection for the extreme case in which the
        content is taller than the available desktop area (large fonts on
        a low screen): its MaxHeight is set from the work area in code,
        and the window then keeps a scrollbar instead of growing beyond
        the screen — the same pattern the first-run window uses.
    -->
    <ScrollViewer x:Name="ContentScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Configurações"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Left" />

            <StackPanel Grid.Row="1" Margin="0,12,0,0">

                <!-- Capture hotkey: the combination that will be active
                     once the settings are saved (or the one that is active
                     right now, with a note, when the saved one could not
                     be registered). Everything is a pending change until
                     the user saves. -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Atalho de captura"
                                   Style="{StaticResource PaneHeaderStyle}" />

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <!-- State: current. Shows the pending hotkey
                                 (the saved one when nothing was changed)
                                 and the actions to change or reset it. -->
                            <Grid x:Name="CurrentPanel">
                                <StackPanel>
                                    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="CurrentHotkeyText"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="CurrentNote"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <!-- State: recording. The dashed border is a
                                 focusable target that captures the key
                                 combination the user presses. -->
                            <Grid x:Name="RecordingPanel" Visibility="Collapsed">
                                <!-- The dashed outline is decorative; the
                                     focusable Grid receives the keyboard
                                     focus and, through the PreviewKeyDown
                                     handler, captures the keys. -->
                                <Grid x:Name="KeyCaptureTarget"
                                      Focusable="True"
                                      Background="Transparent"
                                      PreviewKeyDown="RecordingTarget_PreviewKeyDown">
                                    <Rectangle Stroke="{DynamicResource BorderStrongBrush}"
                                               StrokeThickness="1"
                                               StrokeDashArray="4 3"
                                               IsHitTestVisible="False" />
                                    <StackPanel Margin="12,8">
                                        <TextBlock Text="Pressione a combinação de teclas do novo atalho de captura."
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Esc cancela."
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="RecordingError"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button x:Name="ChangeButton"
                                    Content="Alterar atalho"
                                    MinWidth="120"
                                    Click="ChangeButton_Click" />
                            <Button x:Name="ResetButton"
                                    Content="Restaurar padrão"
                                    MinWidth="130"
                                    Margin="8,0,0,0"
                                    Click="ResetButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Direct mode: the actions that run right after a
                     selection, with no result window interaction. The
                     toggle enables/disables the mode (the configured
                     combinations are preserved while it is off); the
                     three slots are independent combinations, unset by
                     default; the save policy and its folder apply to the
                     "save image" action. Everything is a pending change
                     until the user saves. -->
                <Border Margin="0,12,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Modo Direto"
                                       Style="{StaticResource PaneHeaderStyle}"
                                       VerticalAlignment="Center" />
                            <ToggleButton x:Name="DirectModeToggle"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Ativar Modo Direto"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Checked="DirectModeToggle_Toggled"
                                          Unchecked="DirectModeToggle_Toggled" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Executa a ação imediatamente após a seleção, sem a janela de resultado. As combinações não configuradas não registram atalho." />

                        <StackPanel x:Name="DirectContent"
                                    Grid.Row="2" Margin="0,10,0,0"
                                    IsEnabled="False">

                            <!-- The dynamic state of the direct mode (the
                                 pending configuration plus the live
                                 registrations): it points the user to what
                                 is configured and what is missing, and it
                                 is hidden while the mode is off. -->
                            <TextBlock x:Name="DirectModeStateText"
                                       Margin="0,0,0,8"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <!-- The three direct slots: the configured
                                 combination (or "not configured") and the
                                 actions to record a new one or clear it.
                                 The Tag carries the slot id the shared
                                 handlers use. -->
                            <StackPanel x:Name="DirectSlotsPanel">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Copiar imagem"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="DirectCopyImageText"
                                               Grid.Column="1" Margin="12,0"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Alterar"
                                                MinWidth="0" Padding="10,4" FontSize="12"
                                                Tag="2"
                                                Click="SlotChangeButton_Click" />
                                        <Button x:Name="DirectCopyImageClearButton"
                                                Content="Limpar"
                                                MinWidth="0" Padding="10,4" FontSize="12"
                                                Margin="6,0,0,0"
                                                Tag="2"
                                                Click="SlotClearButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DirectCopyImageNote"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <Grid Margin="0,10,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="OCR + copiar texto"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="DirectCopyTextText"
                                               Grid.Column="1" Margin="12,0"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Alterar"
                                                MinWidth="0" Padding="10,4" FontSize="12"
                                                Tag="3"
                                                Click="SlotChangeButton_Click" />
                                        <Button x:Name="DirectCopyTextClearButton"
                                                Content="Limpar"
                                                MinWidth="0" Padding="10,4" FontSize="12"
                                                Margin="6,0,0,0"
                                                Tag="3"
                                                Click="SlotClearButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DirectCopyTextNote"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <Grid Margin="0,10,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Salvar imagem"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="DirectSaveImageText"
                                               Grid.Column="1" Margin="12,0"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Alterar"
                                                MinWidth="0" Padding="10,4" FontSize="12"
                                                Tag="4"
                                                Click="SlotChangeButton_Click" />
                                        <Button x:Name="DirectSaveImageClearButton"
                                                Content="Limpar"
                                                MinWidth="0" Padding="10,4" FontSize="12"
                                                Margin="6,0,0,0"
                                                Tag="4"
                                                Click="SlotClearButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DirectSaveImageNote"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- State: recording a direct slot. The same
                                 dashed-border target the capture pane
                                 uses; the shared handler writes the
                                 recorded combination to the slot that
                                 started the recording. -->
                            <Grid x:Name="DirectRecordingPanel" Visibility="Collapsed">
                                <Grid x:Name="KeyCaptureTargetDirect"
                                      Focusable="True"
                                      Background="Transparent"
                                      PreviewKeyDown="RecordingTarget_PreviewKeyDown">
                                    <Rectangle Stroke="{DynamicResource BorderStrongBrush}"
                                               StrokeThickness="1"
                                               StrokeDashArray="4 3"
                                               IsHitTestVisible="False" />
                                    <StackPanel Margin="12,8">
                                        <TextBlock x:Name="RecordingDirectText"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Esc cancela."
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="RecordingDirectError"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- The save policy of the "save image"
                                 action: ask for a location on every
                                 action (manual), or write to the folder
                                 below (automatic). -->
                            <TextBlock Text="Política de salvamento"
                                       Style="{StaticResource PaneHeaderStyle}"
                                       Margin="0,12,0,0" />

                            <ListBox x:Name="DirectPolicySelector"
                                     Margin="0,8,0,0"
                                     SelectionChanged="DirectPolicySelector_SelectionChanged">
                                <ListBoxItem>
                                    <StackPanel>
                                        <TextBlock Text="Manual"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Pergunta o local a cada ação (diálogo)"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel>
                                        <TextBlock Text="Automático"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Salva na pasta escolhida, com nome único"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <!-- The automatic policy's destination folder:
                                 shown (and required) only with the
                                 automatic policy; a missing folder blocks
                                 saving the settings. -->
                            <StackPanel x:Name="DirectFolderPanel" Margin="0,10,0,0">
                                <TextBlock Text="Pasta de salvamento automático"
                                           Style="{StaticResource PaneHeaderStyle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DirectSaveFolderText"
                                             Grid.Column="0"
                                             Style="{StaticResource FolderTextBoxStyle}" />
                                    <Button x:Name="BrowseFolderButton"
                                            Grid.Column="1"
                                            Content="Procurar…"
                                            MinWidth="0" Padding="10,4" FontSize="12"
                                            Margin="8,0,0,0"
                                            Click="BrowseFolderButton_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Theme: the pending preference (Sistema/Claro/Escuro).
                     The selection is applied when the settings are saved. -->
                <Border Margin="0,12,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Tema"
                                   Style="{StaticResource PaneHeaderStyle}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="A troca é aplicada ao salvar as configurações." />

                        <!-- The items are in the enum order (System, Light,
                             Dark), so the selected index is the preference. -->
                        <ListBox x:Name="ThemeSelector"
                                 Grid.Row="2"
                                 Margin="0,8,0,0"
                                 SelectionChanged="ThemeSelector_SelectionChanged">
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Sistema"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Acompanha o tema do Windows"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Claro"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Força o tema claro"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Escuro"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Força o tema escuro"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- The transactional footer: save commits every pending
                 change (validated, applied and persisted as a unit);
                 cancel — like closing the window — discards them and
                 keeps the previous settings and registrations. -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="SaveButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Salvar"
                        MinWidth="100"
                        Click="SaveButton_Click" />
                <Button x:Name="CancelButton"
                        Content="Cancelar"
                        MinWidth="100"
                        Margin="8,0,0,0"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

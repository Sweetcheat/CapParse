<Window x:Class="CapParse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Width="460" Height="620"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <!--
        Window-scoped styles (V0.2, phase 3): the same approach as
        MainWindow (phase 2) — a Modern Fluent look built only on the
        shared semantic tokens (Dynamic Resource), so every element
        re-skins when the theme dictionary is swapped. Scoped to this
        window on purpose: FirstRunWindow keeps its current look.
    -->
    <Window.Resources>

        <!-- Shared button template: rounded chrome, a hover/pressed
             overlay (low-alpha, so it works on both the neutral surface
             and the accent fill) and an outer focus ring. The dotted
             WPF focus visual is replaced by the ring. -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="FocusRing"
                        CornerRadius="10"
                        Margin="2"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource FocusBorderBrush}"
                        Opacity="0" />
                <Border x:Name="Chrome"
                        CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Border x:Name="Overlay"
                                CornerRadius="6"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtleOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Background"
                            Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Neutral (secondary) button. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        </Style>

        <!-- Accent (primary) button: same shape and states, accent fill. -->
        <Style x:Key="AccentButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Slim, borderless list: items are the visual unit. -->
        <ControlTemplate x:Key="ListBoxTemplate" TargetType="ListBox">
            <ScrollViewer x:Name="PART_ItemsHost"
                          Focusable="False"
                          Padding="4"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template" Value="{StaticResource ListBoxTemplate}" />
        </Style>

        <!-- List item: hover overlay, accent-tinted selection, focus
             ring; disabled dims the item. -->
        <ControlTemplate x:Key="ListBoxItemTemplate" TargetType="ListBoxItem">
            <Grid>
                <Border x:Name="FocusRing"
                        CornerRadius="7"
                        Margin="1"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource FocusBorderBrush}"
                        Opacity="0" />
                <Border x:Name="ItemBackground"
                        CornerRadius="6"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background"
                            Value="{DynamicResource SubtleOverlayBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ItemBackground" Property="Background"
                            Value="{DynamicResource AccentSubtleBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}" />
        </Style>

        <!-- Section header inside a pane. -->
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configurações"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">

            <!-- Capture hotkey: the combination that is active right now
                 (or the saved one, with a note, when none could be
                 registered) and the actions to change or reset it. -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Atalho de captura"
                               Style="{StaticResource PaneHeaderStyle}" />

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <!-- State: current. Shows the hotkey that is active
                             right now (or the saved one, with a note, when
                             none could be registered) and the actions to
                             change or reset it. -->
                        <Grid x:Name="CurrentPanel">
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="CurrentHotkeyText"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <TextBlock x:Name="CurrentNote"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- State: recording. The dashed border is a
                             focusable target that captures the key
                             combination the user presses. -->
                        <Grid x:Name="RecordingPanel" Visibility="Collapsed">
                            <!-- The dashed outline is decorative; the
                                 focusable Grid receives the keyboard focus
                                 and, through the PreviewKeyDown handler
                                 below, captures the keys. -->
                            <Grid x:Name="KeyCaptureTarget"
                                  Focusable="True"
                                  Background="Transparent"
                                  PreviewKeyDown="KeyCaptureTarget_PreviewKeyDown">
                                <Rectangle Stroke="{DynamicResource BorderStrongBrush}"
                                           StrokeThickness="1"
                                           StrokeDashArray="4 3"
                                           IsHitTestVisible="False" />
                                <StackPanel Margin="12,8">
                                    <TextBlock Text="Pressione a combinação de teclas do novo atalho."
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Esc cancela."
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="RecordingError"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- State: confirm. Shows the recorded combination
                             and lets the user apply it or discard it. -->
                        <Grid x:Name="ConfirmPanel" Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="CandidateText"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Salvar para aplicar o novo atalho." />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel x:Name="CurrentButtons"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button x:Name="ChangeButton"
                                    Content="Alterar atalho"
                                    MinWidth="120"
                                    Click="ChangeButton_Click" />
                            <Button x:Name="ResetButton"
                                    Content="Restaurar padrão"
                                    MinWidth="130"
                                    Margin="8,0,0,0"
                                    Click="ResetButton_Click" />
                        </StackPanel>
                        <StackPanel x:Name="ConfirmButtons"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Salvar"
                                    MinWidth="100"
                                    Click="SaveButton_Click" />
                            <Button x:Name="CancelButton"
                                    Content="Cancelar"
                                    MinWidth="100"
                                    Margin="8,0,0,0"
                                    Click="CancelButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Theme: the stored preference (Sistema/Claro/Escuro). A
                 selection is persisted and applied immediately, without a
                 restart. -->
            <Border Margin="0,12,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Tema"
                               Style="{StaticResource PaneHeaderStyle}" />

                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="A troca é aplicada imediatamente." />

                    <!-- The items are in the enum order (System, Light,
                         Dark), so the selected index is the preference. -->
                    <ListBox x:Name="ThemeSelector"
                             Grid.Row="2"
                             Margin="0,8,0,0"
                             SelectionChanged="ThemeSelector_SelectionChanged">
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Sistema"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Acompanha o tema do Windows"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Claro"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Força o tema claro"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Escuro"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Força o tema escuro"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>

        <Button Grid.Row="2"
                x:Name="CloseButton"
                Content="Fechar"
                MinWidth="90"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Click="CloseButton_Click" />
    </Grid>
</Window>
